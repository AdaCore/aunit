with "aunit";

project Aunit_Tests is

   --  Default to the portable helper for direct cross builds. Enable XML
   --  capture explicitly when the runtime provides file I/O.
   type FileIO_Type is ("fileio", "nofileio");
   FileIO : FileIO_Type := external ("AUNIT_TEST_FILEIO", "fileio");

   for Languages use ("Ada");
   for Main use
     ("aunit_harness_cases.adb", "aunit_harness_suites.adb",
      "aunit_harness_fixtures.adb", "aunit_harness_cases_filter.adb",
      "aunit_harness_results.adb",
      "aunit_harness_package_filters.adb");
   for Source_Dirs use ("src", "src/" & FileIO);
   for Exec_Dir use "exe";
   for Object_Dir use "obj";

   package Linker is
      for Default_Switches ("ada") use ("-g");
   end Linker;

   package Binder is
      for Default_Switches ("ada") use ("-E", "-static");
   end Binder;

   package Compiler is
      for Default_Switches ("ada") use
        ("-g","-gnatQ", "-O1", "-gnatf", "-gnato", "-gnatwa.Xe", "-gnaty");
   end Compiler;

end Aunit_Tests;

